const { normalizeOpportunity, normalizeUrl } = require("./sourceAdapter");
const net = require("node:net");

const REQUEST_TIMEOUT_MS = 18000;
const MAX_RESPONSE_BYTES = 16 * 1024 * 1024;
const MAX_CONCURRENT_BOARD_REQUESTS = 8;
const MAX_BOARDS_PER_PROVIDER = 150;
const SMARTRECRUITERS_PAGE_SIZE = 100;
const SMARTRECRUITERS_MAX_PAGES = 4;
const DEFAULT_BOARDS = Object.freeze({
  GREENHOUSE: [
    "stripe", "cloudflare", "gitlab", "duolingo", "datadog", "figma", "coinbase",
    "instacart", "mavenclinic", "sweetgreen", "gusto", "chime",
    "deliveroo", "monzo", "trustpilot", "sumup",
    "doximity", "oscar", "talkspace", "zocdoc", "elationhealth", "modernhealth",
    "buildops", "formlabs", "fictiv", "redwoodmaterials", "lucidmotors",
    "brex", "ripple", "robinhood", "sofi", "affirm",
    "flexport", "toast", "healthjoy", "chargepoint", "gymshark", "tide",
  ],
  LEVER: ["spotify", "arcadia", "palantir", "protolabs", "gopuff", "zopa"],
  ASHBY: [
    "ramp", "linear", "notion", "openai", "headway", "benchling", "plaid",
    "virtahealth", "honeybook", "jobber", "snyk", "vanta", "whoop",
    "rula", "higharc", "sondermind", "synthesia", "multiverse",
  ],
  SMARTRECRUITERS: ["Experian", "RedBull", "Palantir"],
});

const SOURCE_ACCESS = Object.freeze([
  ...Object.keys(DEFAULT_BOARDS).map((provider) => ({
    provider,
    access: "LIVE API",
    requiresCredentials: false,
    boardCount: DEFAULT_BOARDS[provider].length,
  })),
  ...["LINKEDIN_JOBS", "INDEED_US", "INDEED_UK", "GLASSDOOR", "ZIPRECRUITER", "REED_UK", "TOTALJOBS_UK",
    "LINKEDIN_COMPANY_POSTS", "FACEBOOK_COMPANY_POSTS", "X_TWITTER", "INSTAGRAM"].map((provider) => ({
    provider,
    access: "AUTHORIZATION REQUIRED",
    requiresCredentials: true,
    boardCount: 0,
  })),
  { provider: "DIRECT_CAREERS_PAGES", access: "MANUAL LINK", requiresCredentials: false, boardCount: 0 },
  { provider: "AUTHORIZED_PARTNER_FEEDS", access: "AUTHORIZATION REQUIRED", requiresCredentials: true, boardCount: 0 },
]);

async function mapWithConcurrency(items, limit, mapper) {
  const results = Array.from({ length: items.length });
  let nextIndex = 0;
  const workers = Array.from({ length: Math.min(limit, items.length) }, async () => {
    while (nextIndex < items.length) {
      const index = nextIndex;
      nextIndex += 1;
      results[index] = await mapper(items[index], index);
    }
  });
  await Promise.all(workers);
  return results;
}

async function discoverAtsJobs(filters = {}) {
  const providers = selectProviders(filters.source);
  const boards = providers.flatMap((provider) =>
    normalizeBoards(provider, filters.boards, filters.onlyRequestedBoards)
      .map((board) => ({ provider, ...board }))
  );
  const boardResults = await mapWithConcurrency(boards, MAX_CONCURRENT_BOARD_REQUESTS, async ({ provider, slug, company }) => {
    try {
      const jobs = await fetchBoard(provider, slug);
      const refreshedAt = new Date().toISOString();
      return {
        jobs: jobs.map((job) => normalizeProviderJob(provider, slug, company, job)),
        status: {
          provider,
          board: slug,
          access: "LIVE API",
          status: "CONNECTED",
          returned: jobs.length,
          lastCheckedAt: refreshedAt,
          lastSuccessfulRefresh: refreshedAt,
          ...(Number.isFinite(jobs.totalFound) ? { totalAvailable: jobs.totalFound, truncated: jobs.truncated } : {}),
        },
      };
    } catch (error) {
      const authorizationRequired = error.code === "AUTHORIZATION_REQUIRED";
      const rateLimited = error.statusCode === 429;
      return {
        jobs: [],
        status: {
          provider,
          board: slug,
          access: authorizationRequired ? "AUTHORIZATION REQUIRED" : "UNAVAILABLE",
          status: authorizationRequired ? "AUTH_REQUIRED" : rateLimited ? "RATE_LIMITED" : "ERROR",
          lastCheckedAt: new Date().toISOString(),
          error: error.message,
        },
      };
    }
  });

  const statuses = boardResults.map((result) => result.status);
  const candidates = boardResults.flatMap((result) => result.jobs)
    .filter((job) => job && isInRequestedCountry(job.country, filters.country));
  const matched = candidates
    .filter((job) => matchesFilters(job, filters))
    .map((job) => ({
      ...job,
      matchingExplanation: describeCampaignMatch(job, filters),
    }))
    .sort((left, right) => campaignRelevanceScore(right, filters) - campaignRelevanceScore(left, filters));
  const unique = [];
  const seen = new Set();
  for (const job of matched) {
    const keys = duplicateKeys(job);
    if (keys.some((key) => seen.has(key))) continue;
    keys.forEach((key) => seen.add(key));
    unique.push(job);
  }
  return { opportunities: unique, sourceStatus: statuses };
}

async function verifyAtsJob({ provider, board, externalId }) {
  if (typeof provider !== "string" || typeof board !== "string" || externalId == null) {
    throw inputError("provider, board, and externalId are required.");
  }
  const normalizedProvider = provider.toUpperCase();
  if (!DEFAULT_BOARDS[normalizedProvider]) throw inputError("Unsupported ATS provider.");
  const safeBoard = validateBoardSlug(board, normalizedProvider);
  const jobs = await fetchBoard(normalizedProvider, safeBoard);
  const found = jobs.find((job) => String(job.id ?? job.jobId) === String(externalId));
  if (!found) {
    const error = new Error("The job is no longer available on the selected public ATS board.");
    error.statusCode = 404;
    throw error;
  }
  const company = getBoardCompany(normalizedProvider, safeBoard);
  const opportunity = normalizeProviderJob(normalizedProvider, safeBoard, company, found);
  if (!opportunity || !opportunity.country) {
    throw inputError("The live job does not identify a supported US or UK location.");
  }
  return opportunity;
}

function normalizeBoards(provider, requestedBoards, onlyRequestedBoards = false) {
  const defaults = DEFAULT_BOARDS[provider];
  const custom = Array.isArray(requestedBoards)
    ? requestedBoards.filter((entry) => entry && String(entry.provider).toUpperCase() === provider).map((entry) => entry.slug)
    : [];
  const base = onlyRequestedBoards ? [] : defaults;
  const slugs = [...new Set([...base, ...custom].map((slug) => validateBoardSlug(slug, provider)))].slice(0, MAX_BOARDS_PER_PROVIDER);
  return slugs.map((slug) => ({ slug, company: getBoardCompany(provider, slug) }));
}

function validateBoardSlug(value, provider) {
  const raw = String(value || "").trim();
  const slug = provider === "SMARTRECRUITERS" ? raw : raw.toLowerCase();
  if (!/^[a-z0-9][a-z0-9-]{0,79}$/.test(slug)) {
    if (provider !== "SMARTRECRUITERS" || !/^[A-Za-z0-9][A-Za-z0-9-]{0,79}$/.test(slug)) {
      throw inputError("ATS board identifiers may contain only letters, numbers, and hyphens.");
    }
  }
  return slug;
}

