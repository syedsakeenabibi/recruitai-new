    deliveroo: "Deliveroo",
    monzo: "Monzo",
    trustpilot: "Trustpilot",
    sumup: "SumUp",
    spotify: "Spotify",
    ramp: "Ramp",
    linear: "Linear",
    notion: "Notion",
    openai: "OpenAI",
    Experian: "Experian",
    RedBull: "Red Bull",
    flexport: "Flexport",
    toast: "Toast",
    healthjoy: "HealthJoy",
    chargepoint: "ChargePoint",
    gymshark: "Gymshark",
    tide: "Tide",
    zopa: "Zopa",
    synthesia: "Synthesia",
    multiverse: "Multiverse",
    gopuff: "Gopuff",
